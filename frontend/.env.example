# REST API endpoint (Ví dụ trên production: https://unisync-api.duckdns.org/api)
VITE_API_URL=http://localhost:8080/api

# WebSocket STOMP endpoint (Ví dụ trên production: wss://unisync-api.duckdns.org/ws)
# Nếu không điền, frontend sẽ tự suy luận từ VITE_API_URL (http -> ws, https -> wss)
VITE_WS_URL=ws://localhost:8080/ws
