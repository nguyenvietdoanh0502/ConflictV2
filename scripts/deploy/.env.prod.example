# ==============================================================================
# UNISYNC PRODUCTION ENVIRONMENT VARIABLES (AWS EC2 + NEON + VERCEL)
# Copy file này thành .env trên server EC2 và điền các giá trị thực tế
# ==============================================================================

# Docker Hub Username của bạn (để pull các image)
DOCKER_USERNAME=your_dockerhub_username

# --- Neon.tech PostgreSQL Database (Lấy tại console.neon.tech) ---
# Ví dụ: jdbc:postgresql://ep-silent-wave-123456.ap-southeast-1.aws.neon.tech:5432/neondb?sslmode=require
DB_URL=jdbc:postgresql://<neon-endpoint>:5432/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=your_neon_db_password

# --- Redis (Chạy nội bộ qua Docker) ---
REDIS_PASSWORD=

# --- JWT Secret & Cookie Security ---
# Khóa JWT bí mật (dài tối thiểu 32 ký tự)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
COOKIE_SECURE=true
COOKIE_SAME_SITE=None

# Danh sách domain frontend được phép gọi API (phân cách bởi dấu phẩy)
# Ví dụ: https://unisync.vercel.app,http://localhost:5173
CORS_ALLOWED_ORIGINS=https://*.vercel.app,http://localhost:5173

# --- Email OTP Service (Gmail SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=lminhhieu2507@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# --- Cloudinary Storage (Lưu trữ avatar / ảnh) ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=unisync/avatars

# --- AI Engine (Google Gemini API) ---
# Lấy miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
INTERNAL_API_KEY=unisync_internal_secret_key_2026
