# UniSync AI Engine Configuration
PORT=8000
HOST=0.0.0.0

# Chế độ chạy: 'live' (dùng Gemini API) hoặc 'mock' (giả lập offline không cần key)
AI_MODE=live

# Google Gemini API Key - Hãy copy file này thành .env và điền API key của bạn vào đây:
# Lấy key miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Khuyên dùng gemini-3.5-flash-lite (nhanh, ổn định) hoặc gemini-3.8-flash:
GEMINI_MODEL=gemini-3.5-flash-lite

# Khóa bí mật giao tiếp nội bộ giữa Spring Boot và AI Service
INTERNAL_API_KEY=your_internal_secret_key_here
